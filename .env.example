# Copy this file to ".env" and change the values
PORT=3000
JWT_SECRET=change-this-to-a-long-random-string

# true = new business/NGO accounts are verified automatically (good for demos).
# false = an admin must verify them first (admin@foodsave.test -> Impact page).
AUTO_VERIFY=true

# Platform commission on completed discounted orders (0.10 = 10%)
COMMISSION_RATE=0.10

# Optional: Google Gemini key for the AI explanation note on discount suggestions.
# Leave empty and the app still works using its built-in rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Default map centre used when a user has not shared a location (Islamabad)
DEFAULT_LAT=33.6844
DEFAULT_LNG=73.0479
